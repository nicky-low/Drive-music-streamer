<?xml version="1.0" encoding="utf-8"?>
<!-- Five rounded bars like a sound wave; the tall centre bar doubles as an "I"
     for Inshyra. Kept inside the 66dp centre circle that every launcher
     shape (circle, squircle, ...) is guaranteed to show. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer, short bars -->
    <path
        android:pathData="M30,46 L30,62 M78,46 L78,62"
        android:strokeColor="#FF8F9BFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
    <!-- inner, medium bars -->
    <path
        android:pathData="M42,38 L42,70 M66,38 L66,70"
        android:strokeColor="#FF8F9BFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
    <!-- the tall centre bar, brightest -->
    <path
        android:pathData="M54,28 L54,80"
        android:strokeColor="#FFE9ECFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
</vector>
