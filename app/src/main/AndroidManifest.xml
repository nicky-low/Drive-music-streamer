<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Lets ExoPlayer hold a CPU + Wi-Fi wake lock while streaming, so
         playback doesn't stall with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Needed on Android 13+ for the library-loading progress
         notification to actually show; the service still runs and
         completes without it, it just won't have a visible notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Drive Streamer"
        android:theme="@style/Theme.DriveStreamer">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LibraryActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.NowPlayingActivity"
            android:exported="false"
            android:parentActivityName=".ui.LibraryActivity" />

        <!-- The MediaBrowserService is what Android Auto actually binds to. -->
        <service
            android:name=".playback.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Runs the (potentially long) library load independently of
             LibraryActivity's lifecycle — see LibraryLoadService for why. -->
        <service
            android:name=".playback.LibraryLoadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Serves album art lazily to Android Auto's browse list via
             content URIs — see AlbumArtContentProvider for why this is
             a provider rather than embedding art in every browse item. -->
        <provider
            android:name=".playback.AlbumArtContentProvider"
            android:authorities="com.example.drivestreamer.albumart"
            android:exported="true"
            android:grantUriPermissions="true" />

    </application>
</manifest>
